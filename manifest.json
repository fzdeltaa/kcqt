{
  "manifest_version": 2,
  "name": "KC Quest Tracker",
  "short_name": "KCQT",
  "description": "Standalone quest state tracker for Kantai Collection",
  "version": "0.1.0",
  "browser_action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dmm.com/*",
        "*://*.kancolle-server.com/*"
      ],
      "js": ["inject/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "*://*.dmm.com/*",
    "*://*.kancolle-server.com/*"
  ],
  "web_accessible_resources": [
    "inject/page.js"
  ]
}